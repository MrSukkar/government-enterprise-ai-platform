                ArchitectureDiscoveryId = Guid.NewGuid();
                PackageSelectionId = Guid.NewGuid();
                PlanningId = Guid.NewGuid();
                GenerationId = Guid.NewGuid();
                DeliveryRunId = Guid.NewGuid();
