            <li><span>Supply-chain verifiers, authorization, and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Deployment OPA and verified Artifact</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Sovereign profile and trusted dependencies</span><strong class="waiting">Signed profile adapter available; not configured</strong></li>
            <li><span>Institutional preflight and runtime gateway</span><strong class="waiting">Provider-neutral adapter available; not configured</strong></li>
            <li><span>Deployment result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>OpenTelemetry OPA and Deployment receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Signed telemetry profile and strict redaction</span><strong class="waiting">Verifier adapter available; not configured</strong></li>
            <li><span>Trusted sovereign collector gateway</span><strong class="waiting">Provider-neutral adapter available; not configured</strong></li>
            <li><span>Telemetry result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Automatic Registration OPA and OpenTelemetry receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Signed registration manifest and atomic repository</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Registration result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Enterprise Model OPA and registration receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Authorized registered Enterprise Object reader</span><strong class="waiting">Adapter available; not configured</strong></li>
            <li><span>Context result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Evidence OPA and Enterprise Model receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Append-only chain, sovereign signer, and verifier</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Complete ten-stage cryptographic proof</span><strong class="waiting">Adapters available; not configured</strong></li>
        </ul>
        <div class="policy-note"><strong>Completed contract</strong><p>The final protected API binds Evidence completion to accepted Enterprise Model contextualization and a run stopped at EnterpriseModel. OPA and Evidence authorization precede access; the Phase 30 engine appends only the final Evidence entry and verifies all ten ordered entries, hashes, links, signatures, scope, and completeness. No post-Evidence station exists.</p></div>
    </aside>
</section>

<section class="delivery-map" aria-labelledby="delivery-heading">
    <div class="section-heading"><div><p class="eyebrow">Approved execution path</p><h2 id="delivery-heading">From intent to proof</h2></div><p>No stage can be skipped by AI, UI, or an operator.</p></div>
    <ol class="stage-grid">
        @foreach (var stage in Stages)
        {
            <li class="stage-card"><span>@stage.Ordinal.ToString("00")</span><strong>@stage.Name</strong><small>@stage.Gate</small></li>
        }
    </ol>
</section>

<section class="assurance-bar" aria-label="Create Internal Service assurance">
    <div><strong>OPA decides</strong><span>Policy authority</span></div>
    <div><strong>Humans approve</strong><span>Separation of duties</span></div>
    <div><strong>Git records</strong><span>Immutable change history</span></div>
    <div><strong>Evidence proves</strong><span>Cryptographic trust chain</span></div>
</section>

@code {
    private string ServiceName { get; set; } = "National Permit Renewal";
    private string Mission { get; set; } = "Reduce renewal effort while preserving eligibility, policy, and audit controls.";
    private string PrimaryUsers { get; set; } = "Residents and permit officers";
    private string Classification { get; set; } = "Internal";
    private string IntentEvidenceReference { get; set; } = string.Empty;
    private int DraftScore { get; set; } = 100;
    private string EvaluationMessage { get; set; } = "Draft is complete enough for governed intent submission. Submission remains locked.";
    private bool IsSubmitting { get; set; }
    private bool IsRegistering { get; set; }
    private bool IsDiscoveringContext { get; set; }
    private bool IsDiscoveringSystems { get; set; }
    private bool IsDiscoveringArchitecture { get; set; }
    private bool IsSelectingPackages { get; set; }
    private bool IsCreatingPlanningCandidate { get; set; }
    private bool IsCreatingCodeCandidate { get; set; }
    private IntentValidationReceipt? LastReceipt { get; set; }
    private IntentSubmissionRequest? LastSubmission { get; set; }
    private IntentRegistrationReceipt? RegistrationReceipt { get; set; }
    private EnterpriseContextReceipt? ContextReceipt { get; set; }
    private ExistingSystemsReceipt? SystemsReceipt { get; set; }
    private ExistingArchitectureReceipt? ArchitectureReceipt { get; set; }
    private ApprovedPackagesReceipt? PackagesReceipt { get; set; }
    private AiPlanningReceipt? PlanningReceipt { get; set; }
    private GovernedCodeGenerationReceipt? CodeGenerationReceipt { get; set; }
    private Guid RegistrationId { get; set; }
    private Guid ContextDiscoveryId { get; set; }
    private Guid SystemsDiscoveryId { get; set; }
    private Guid ArchitectureDiscoveryId { get; set; }
    private Guid PackageSelectionId { get; set; }
    private Guid PlanningId { get; set; }
    private Guid GenerationId { get; set; }
    private Guid DeliveryRunId { get; set; }

    private bool CanSubmit =>
        ExperienceContext.HasPermission("developer.internal-service.create") &&
        !string.IsNullOrWhiteSpace(ExperienceContext.TenantId) &&
        !string.IsNullOrWhiteSpace(ExperienceContext.AuthorizationEvidenceReference) &&
        !string.IsNullOrWhiteSpace(ServiceName) &&
        !string.IsNullOrWhiteSpace(Mission) &&
        !string.IsNullOrWhiteSpace(PrimaryUsers) &&
        !string.IsNullOrWhiteSpace(Classification) &&
        !string.IsNullOrWhiteSpace(IntentEvidenceReference);

    private bool CanRegister =>
        LastSubmission is not null &&
        LastReceipt is not null &&
        ExperienceContext.HasPermission("developer.internal-service.intent.register");

    private bool CanDiscoverContext =>
        RegistrationReceipt is { IsPersisted: true, Version: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.context.discover");

    private bool CanDiscoverSystems =>
        ContextReceipt is { IsContextReleased: true, CanAdvance: false, ContextSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.systems.discover");

    private bool CanDiscoverArchitecture =>
        SystemsReceipt is { IsInventoryReleased: true, CanAdvance: false, InventorySha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.architecture.discover");

    private bool CanSelectPackages =>
        ArchitectureReceipt is { IsArchitectureReleased: true, CanAdvance: false, ArchitectureSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.packages.select");

    private bool CanCreatePlanningCandidate =>
        PackagesReceipt is { IsSelectionReleased: true, CanAdvance: false, SelectionSha256Digest: not null, SelectionEvidenceReference: not null } &&
        ContextReceipt?.DiscoveryEvidenceReference is not null &&
        SystemsReceipt?.DiscoveryEvidenceReference is not null &&
        ArchitectureReceipt?.DiscoveryEvidenceReference is not null &&
        ExperienceContext.HasPermission("developer.internal-service.ai-planning.create");

    private bool CanCreateCodeCandidate =>
        RegistrationReceipt is { IsPersisted: true } &&
        ContextReceipt is { IsContextReleased: true } &&
        SystemsReceipt is { IsInventoryReleased: true } &&
        ArchitectureReceipt is { IsArchitectureReleased: true } &&
        PlanningReceipt is { IsPlanningCandidateReleased: true, IsExecutable: false, CanAdvance: false,
            CandidateSha256Digest: not null, PlanningEvidenceReference: not null } &&
        PackagesReceipt is { IsSelectionReleased: true, SelectionSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.code-generation.create");

    private static IReadOnlyList<StudioStage> Stages { get; } =
    [
        new(1, "Intent", "Identity + purpose"),
        new(2, "Enterprise context", "Authorized retrieval"),
        new(3, "Existing systems", "Scoped dependencies"),
        new(4, "Existing architecture", "Approved baseline"),
        new(5, "Approved packages", "Verified sources"),
        new(6, "AI planning", "Proposal only"),
        new(7, "Code generation", "No production path"),
        new(8, "Static validation", "Deterministic checks"),
        new(9, "Security validation", "Security gate"),
        new(10, "Sandbox", "Isolated execution"),
        new(11, "Tests", "Deterministic gates"),
        new(12, "Human review", "Separation of duties"),
        new(13, "Git", "Immutable source"),
        new(14, "CI/CD", "Signed provenance"),
        new(15, "Artifact", "Verified supply chain"),
        new(16, "Deployment", "Approved artifact"),
        new(17, "OpenTelemetry", "Correlated telemetry"),
        new(18, "Automatic registration", "Governed registration"),
        new(19, "Enterprise Model", "Context source of truth"),
        new(20, "Evidence", "Cryptographic trust chain")
    ];

    private void EvaluateDraft()
    {
        var values = new[] { ServiceName, Mission, PrimaryUsers, Classification, IntentEvidenceReference };
        DraftScore = values.Count(value => !string.IsNullOrWhiteSpace(value)) * 20;
       EvaluationMessage = DraftScore == 100
            ? CanSubmit
                ? "Draft and governed identity are ready for server validation."
                : "Draft is complete. Sign in and establish governed identity before submission."
            : $"Complete the missing fields before governed submission. Current completeness: {DraftScore}%.";
    }

    private async Task SubmitIntentAsync()
    {
        if (!CanSubmit)
        {
            EvaluationMessage = "Submission requires governed identity, tenant, permission, and intent evidence.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var request = new IntentSubmissionRequest(
                Guid.NewGuid(),
                ExperienceContext.TenantId!,
                ExperienceContext.Purpose,
                Classification,
                ServiceName,
                Mission,
                PrimaryUsers,
