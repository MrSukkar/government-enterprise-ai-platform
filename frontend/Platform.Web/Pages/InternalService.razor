@page "/build/internal-services"
@inject ExperienceContext ExperienceContext
@inject HttpClient Http
@implements IDisposable

<PageTitle>Create Internal Service | Government Enterprise AI Platform</PageTitle>

<section class="studio-hero" aria-labelledby="studio-heading">
    <div>
        <p class="eyebrow">Integration Demo Stage 08 / Governed Code Generation</p>
        <h1 id="studio-heading">Create Internal Service Workspace</h1>
        <p class="hero-copy">Turn a government service intent into governed software, operational registration, and verifiable evidence.</p>
    </div>
    <aside class="studio-state" aria-label="Product execution status">
        <span class="state-chip">OPA + SOVEREIGN AI + INDEPENDENT EVALUATION + EVIDENCE</span>
        <strong>Governed Code Generation candidate path available; deployment configuration required</strong>
        <small>Exact accepted planning evidence and policy permit precede generation. Candidate content remains inert, unapplied, non-executable, and non-advancing.</small>
    </aside>
</section>

<section class="studio-grid" aria-label="Create Internal Service workspace">
    <div class="workspace-card intent-workspace">
        <div class="card-heading"><div><p class="eyebrow">01 / Governed intent</p><h2>Describe the service mission</h2></div><span class="score">@DraftScore%</span></div>
        <label for="service-name">Service name</label>
        <input id="service-name" @bind="ServiceName" placeholder="e.g. Permit Renewal Service" />
        <label for="service-mission">Mission and measurable outcome</label>
        <textarea id="service-mission" @bind="Mission" rows="4" placeholder="What public or institutional outcome must improve?"></textarea>
        <div class="field-grid">
            <div><label for="service-users">Primary users</label><input id="service-users" @bind="PrimaryUsers" placeholder="Residents, inspectors, analysts..." /></div>
            <div><label for="classification">Classification</label><select id="classification" @bind="Classification"><option value="">Select</option><option>Public</option><option>Internal</option><option>Confidential</option><option>Secret</option><option>TopSecret</option></select></div>
        </div>
        <label for="intent-evidence">Intent evidence reference</label>
        <input id="intent-evidence" @bind="IntentEvidenceReference" placeholder="evidence://intent/..." />
        <div class="intent-actions">
            <button type="button" class="secondary-action" @onclick="EvaluateDraft">Evaluate intent</button>
            <button type="button" class="primary-action" disabled="@(!CanSubmit || IsSubmitting)" @onclick="SubmitIntentAsync">@(IsSubmitting ? "Validating..." : "Submit governed intent")</button>
            <button type="button" class="primary-action" disabled="@(!CanRegister || IsRegistering)" @onclick="RegisterIntentAsync">@(IsRegistering ? "Registering..." : "Register with OPA + PostgreSQL")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverContext || IsDiscoveringContext)" @onclick="DiscoverEnterpriseContextAsync">@(IsDiscoveringContext ? "Discovering..." : "Discover authorized context")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverSystems || IsDiscoveringSystems)" @onclick="DiscoverExistingSystemsAsync">@(IsDiscoveringSystems ? "Discovering..." : "Discover existing systems")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverArchitecture || IsDiscoveringArchitecture)" @onclick="DiscoverExistingArchitectureAsync">@(IsDiscoveringArchitecture ? "Discovering..." : "Discover existing architecture")</button>
            <button type="button" class="primary-action" disabled="@(!CanSelectPackages || IsSelectingPackages)" @onclick="SelectApprovedPackagesAsync">@(IsSelectingPackages ? "Selecting..." : "Select approved packages")</button>
            <button type="button" class="primary-action" disabled="@(!CanCreatePlanningCandidate || IsCreatingPlanningCandidate)" @onclick="CreatePlanningCandidateAsync">@(IsCreatingPlanningCandidate ? "Planning..." : "Create governed AI plan")</button>
            <button type="button" class="primary-action" disabled="@(!CanCreateCodeCandidate || IsCreatingCodeCandidate)" @onclick="CreateCodeCandidateAsync">@(IsCreatingCodeCandidate ? "Generating..." : "Create governed code candidate")</button>
        </div>
        <p class="evaluation" role="status">@EvaluationMessage</p>
        @if (LastReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed intent validation receipt">
                <div><dt>Submission</dt><dd>@LastReceipt.SubmissionId</dd></div>
                <div><dt>Status</dt><dd>@LastReceipt.Status</dd></div>
                <div><dt>Intent digest</dt><dd>@LastReceipt.IntentDigest</dd></div>
                <div><dt>Persisted</dt><dd>@(LastReceipt.IsPersisted ? "Yes" : "No — validation only")</dd></div>
            </dl>
        }
        @if (RegistrationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed intent registration receipt">
                <div><dt>Registration</dt><dd>@RegistrationReceipt.RegistrationId</dd></div>
                <div><dt>Policy</dt><dd>@RegistrationReceipt.PolicyOutcome</dd></div>
                <div><dt>Disposition</dt><dd>@RegistrationReceipt.Disposition</dd></div>
                <div><dt>Evidence</dt><dd>@RegistrationReceipt.RegistrationEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(RegistrationReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (ContextReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Enterprise Context receipt">
                <div><dt>Discovery</dt><dd>@ContextReceipt.DiscoveryId</dd></div>
                <div><dt>Policy</dt><dd>@ContextReceipt.PolicyOutcome</dd></div>
                <div><dt>Released items</dt><dd>@ContextReceipt.Items.Count</dd></div>
                <div><dt>Context digest</dt><dd>@ContextReceipt.ContextSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@ContextReceipt.DiscoveryEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(ContextReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (SystemsReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Existing Systems receipt">
                <div><dt>Discovery</dt><dd>@SystemsReceipt.DiscoveryId</dd></div>
                <div><dt>Released systems</dt><dd>@SystemsReceipt.Systems.Count</dd></div>
                <div><dt>Inventory digest</dt><dd>@SystemsReceipt.InventorySha256Digest</dd></div>
                <div><dt>Can advance</dt><dd>@(SystemsReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (ArchitectureReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Existing Architecture receipt">
                <div><dt>Discovery</dt><dd>@ArchitectureReceipt.DiscoveryId</dd></div>
                <div><dt>Released items</dt><dd>@ArchitectureReceipt.Items.Count</dd></div>
                <div><dt>Architecture digest</dt><dd>@ArchitectureReceipt.ArchitectureSha256Digest</dd></div>
                <div><dt>Can advance</dt><dd>@(ArchitectureReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (PackagesReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Approved Packages receipt">
                <div><dt>Selection</dt><dd>@PackagesReceipt.SelectionId</dd></div>
                <div><dt>Released packages</dt><dd>@PackagesReceipt.Packages.Count</dd></div>
                <div><dt>Selection digest</dt><dd>@PackagesReceipt.SelectionSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@PackagesReceipt.SelectionEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(PackagesReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (PlanningReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed AI Planning receipt">
                <div><dt>Planning</dt><dd>@PlanningReceipt.PlanningId</dd></div>
                <div><dt>Policy</dt><dd>@PlanningReceipt.PolicyOutcome</dd></div>
                <div><dt>Candidate digest</dt><dd>@PlanningReceipt.CandidateSha256Digest</dd></div>
                <div><dt>Evaluation findings</dt><dd>@PlanningReceipt.EvaluationFindings.Count</dd></div>
                <div><dt>Evidence</dt><dd>@PlanningReceipt.PlanningEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(PlanningReceipt.IsExecutable ? "Yes" : "No — planning only")</dd></div>
                <div><dt>Can advance</dt><dd>@(PlanningReceipt.CanAdvance ? "Yes" : "No — Code Generation remains separate")</dd></div>
            </dl>
        }
        @if (CodeGenerationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Code Generation receipt">
                <div><dt>Generation</dt><dd>@CodeGenerationReceipt.GenerationId</dd></div>
                <div><dt>Policy</dt><dd>@CodeGenerationReceipt.PolicyOutcome</dd></div>
                <div><dt>Candidate digest</dt><dd>@CodeGenerationReceipt.CandidateSha256Digest</dd></div>
                <div><dt>Authorized output paths</dt><dd>@CodeGenerationReceipt.GeneratedFilePaths.Count</dd></div>
                <div><dt>Evaluation findings</dt><dd>@CodeGenerationReceipt.EvaluationFindings.Count</dd></div>
                <div><dt>Evidence</dt><dd>@CodeGenerationReceipt.GenerationEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(CodeGenerationReceipt.IsExecutable ? "Yes" : "No — inert candidate data")</dd></div>
                <div><dt>Applied</dt><dd>@(CodeGenerationReceipt.IsApplied ? "Yes" : "No — no filesystem write")</dd></div>
                <div><dt>Can advance</dt><dd>@(CodeGenerationReceipt.CanAdvance ? "Yes" : "No — Static Validation remains separate")</dd></div>
            </dl>
        }
    </div>

    <aside class="workspace-card context-panel">
        <p class="eyebrow">02 / Authorized context</p><h2>Enterprise context</h2>
        <ul class="context-list">
            <li><span>Identity and purpose</span><strong class="@(ExperienceContext.IsGovernedIdentityEstablished ? "available" : "waiting")">@(ExperienceContext.IsGovernedIdentityEstablished ? "Established" : "Waiting")</strong></li>
            <li><span>Governed Intent reader</span><strong class="@(RegistrationReceipt is not null ? "available" : "waiting")">@(RegistrationReceipt is not null ? "Registered" : "Waiting")</strong></li>
            <li><span>Enterprise Context OPA, Graph, and evidence</span><strong class="@(ContextReceipt?.IsContextReleased == true ? "available" : "waiting")">@(ContextReceipt?.IsContextReleased == true ? "Authorized and evidenced" : "Waiting")</strong></li>
            <li><span>Enterprise Context snapshot reader</span><strong class="@(ContextReceipt?.IsContextReleased == true ? "available" : "waiting")">@(ContextReceipt?.IsContextReleased == true ? "Snapshot recorded" : "Waiting")</strong></li>
            <li><span>Existing Systems OPA gate</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Enterprise Graph inventory source</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>System and relationship authorizer</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Inventory evidence recorder</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Systems snapshot reader</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Architecture OPA gate</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Architecture Graph source</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Architecture conformance and authorization</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Architecture evidence recorder</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Existing Architecture snapshot reader</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Approved Packages OPA gate</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Institutional package catalog</span><strong class="waiting">Adapter available / no catalog configured</strong></li>
            <li><span>Signed supply-chain assurance</span><strong class="waiting">Adapter available / no trust configured</strong></li>
            <li><span>Package result authorizer and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Approved Packages snapshot and delivery run</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>AI Planning OPA and governed prompt</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Context re-authorization</span><strong class="waiting">Adapter available / not configured</strong></li>
            <li><span>Sovereign AI runtime and independent evaluator</span><strong class="waiting">Adapters available / no endpoints configured</strong></li>
            <li><span>Planning result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>AI Planning candidate and Code Generation run</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Code Generation OPA and governed prompt</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Sovereign Code Generation and independent evaluator</span><strong class="waiting">Adapters available / no endpoints configured</strong></li>
            <li><span>Generated-path/result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Static Validation OPA and candidate reader</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Institutionally approved signed Static controls</span><strong class="waiting">Runtime available / no profiles configured</strong></li>
            <li><span>Static result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Security Validation OPA and prerequisite readers</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Institutionally approved signed Security controls</span><strong class="waiting">Runtime available / no profiles configured</strong></li>
            <li><span>Security result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Sandbox OPA and immutable Security-chain readers</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Institutional sandbox image and supply-chain assurance</span><strong class="waiting">Adapters available / no image configured</strong></li>
            <li><span>Signed Firecracker-class sovereign sandbox runtime</span><strong class="waiting">Protocol available / not configured</strong></li>
            <li><span>Sandbox result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Tests OPA and immutable prerequisite readers</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Governed test manifest and institutional image</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Signed sovereign governed test runtime</span><strong class="waiting">Protocol available / not configured</strong></li>
            <li><span>Tests result authorization and evidence</span><strong class="waiting">Adapters available / not configured</strong></li>
            <li><span>Human Review OPA and exact prerequisite readers</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Human identity and separation of duties</span><strong class="waiting">Enforced when institutionally configured</strong></li>
            <li><span>Non-repudiable reviewer attestation</span><strong class="waiting">Signed verifier adapter available; not configured</strong></li>
            <li><span>Atomic review and evidence repository</span><strong class="waiting">PostgreSQL adapter available; not configured</strong></li>
            <li><span>Git OPA and exact prerequisite readers</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Governed change-set materializer and validator</span><strong class="waiting">Signed gateway adapter available; not configured</strong></li>
            <li><span>Institutional Git gateway and commit signer</span><strong class="waiting">Provider-neutral adapter available; not configured</strong></li>
            <li><span>Git result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>CI/CD OPA and signed Git receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Immutable workflow and validator</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Institutional isolated runner gateway</span><strong class="waiting">Provider-neutral adapter available; not configured</strong></li>
            <li><span>CI/CD result authorization and evidence</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Artifact OPA and CI/CD receipt</span><strong class="waiting">Adapters available; not configured</strong></li>
            <li><span>Pipeline-output package validator</span><strong class="waiting">Signed gateway adapter available; not configured</strong></li>
