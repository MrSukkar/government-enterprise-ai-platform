@page "/build/internal-services"
@inject ExperienceContext ExperienceContext
@inject HttpClient Http
@implements IDisposable

<PageTitle>Create Internal Service | Government Enterprise AI Platform</PageTitle>

<section class="studio-hero" aria-labelledby="studio-heading">
    <div>
        <p class="eyebrow">Integration Demo Stage 21 / Governed Evidence Completion</p>
        <h1 id="studio-heading">Create Internal Service Workspace</h1>
        <p class="hero-copy">Turn a government service intent into governed software, operational registration, and verifiable evidence.</p>
    </div>
    <aside class="studio-state" aria-label="Product execution status">
        <span class="state-chip">OPA + APPEND-ONLY CHAIN + SOVEREIGN SIGNATURES + TEN-STAGE PROOF</span>
        <strong>Governed Evidence Completion available; approved runtime keys required</strong>
        <small>Exact contextualization evidence, independent access authorization, atomic append, sovereign signing, and full cryptographic verification precede the final proof. No later station exists.</small>
    </aside>
</section>

<section class="studio-grid" aria-label="Create Internal Service workspace">
    <div class="workspace-card intent-workspace">
        <div class="card-heading"><div><p class="eyebrow">01 / Governed intent</p><h2>Describe the service mission</h2></div><span class="score">@DraftScore%</span></div>
        <label for="service-name">Service name</label>
        <input id="service-name" @bind="ServiceName" placeholder="e.g. Permit Renewal Service" />
        <label for="service-mission">Mission and measurable outcome</label>
        <textarea id="service-mission" @bind="Mission" rows="4" placeholder="What public or institutional outcome must improve?"></textarea>
        <div class="field-grid">
            <div><label for="service-users">Primary users</label><input id="service-users" @bind="PrimaryUsers" placeholder="Residents, inspectors, analysts..." /></div>
            <div><label for="classification">Classification</label><select id="classification" @bind="Classification"><option value="">Select</option><option>Public</option><option>Internal</option><option>Confidential</option><option>Secret</option><option>TopSecret</option></select></div>
        </div>
        <label for="intent-evidence">Intent evidence reference</label>
        <input id="intent-evidence" @bind="IntentEvidenceReference" placeholder="evidence://intent/..." />
        <div class="field-grid">
            <div><label for="review-decision">Human decision</label><select id="review-decision" @bind="ReviewDecision"><option value="Approve">Approve</option><option value="Reject">Reject</option></select></div>
            <div><label for="review-rationale">Review rationale</label><input id="review-rationale" @bind="ReviewRationale" placeholder="Required human rationale" /></div>
        </div>
        <label for="human-attestation">Signed human attestation reference</label>
        <input id="human-attestation" @bind="HumanAttestationReference" placeholder="attestation://institution/..." />
        <div class="field-grid">
            <div><label for="git-repository">Repository identity</label><input id="git-repository" @bind="GitRepositoryId" /></div>
            <div><label for="git-base">Expected immutable base commit</label><input id="git-base" @bind="GitExpectedBaseCommitId" /></div>
        </div>
        <div class="field-grid">
            <div><label for="git-branch">Non-protected change branch</label><input id="git-branch" @bind="GitChangeBranch" /></div>
            <div><label for="git-signing-policy">Signing policy reference</label><input id="git-signing-policy" @bind="GitSigningPolicyReference" /></div>
        </div>
        <label for="git-message">Controlled commit message</label>
        <input id="git-message" @bind="GitCommitMessage" />
        <label for="git-change-set">Expected change-set SHA-256</label>
        <input id="git-change-set" @bind="GitExpectedChangeSetSha256Digest" placeholder="64 lowercase hexadecimal characters from the reviewed change set" />
        <div class="field-grid">
            <div><label for="cicd-workflow">Immutable workflow</label><input id="cicd-workflow" @bind="CiCdWorkflowDefinitionId" /></div>
            <div><label for="cicd-workflow-version">Workflow version</label><input id="cicd-workflow-version" @bind="CiCdWorkflowDefinitionVersion" /></div>
        </div>
        <label for="cicd-workflow-digest">Expected workflow SHA-256</label>
        <input id="cicd-workflow-digest" @bind="CiCdExpectedWorkflowSha256Digest" />
        <label for="artifact-content-digest">Expected Artifact content SHA-256</label>
        <input id="artifact-content-digest" @bind="ArtifactExpectedContentSha256Digest" />
        <label for="deployment-approval">Deployment human approval reference</label>
        <input id="deployment-approval" @bind="DeploymentHumanApprovalReference" placeholder="approval://institution/... (required; never fabricated)" />
        <div class="intent-actions">
            <button type="button" class="secondary-action" @onclick="EvaluateDraft">Evaluate intent</button>
            <button type="button" class="primary-action" disabled="@(!CanSubmit || IsSubmitting)" @onclick="SubmitIntentAsync">@(IsSubmitting ? "Validating..." : "Submit governed intent")</button>
            <button type="button" class="primary-action" disabled="@(!CanRegister || IsRegistering)" @onclick="RegisterIntentAsync">@(IsRegistering ? "Registering..." : "Register with OPA + PostgreSQL")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverContext || IsDiscoveringContext)" @onclick="DiscoverEnterpriseContextAsync">@(IsDiscoveringContext ? "Discovering..." : "Discover authorized context")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverSystems || IsDiscoveringSystems)" @onclick="DiscoverExistingSystemsAsync">@(IsDiscoveringSystems ? "Discovering..." : "Discover existing systems")</button>
            <button type="button" class="primary-action" disabled="@(!CanDiscoverArchitecture || IsDiscoveringArchitecture)" @onclick="DiscoverExistingArchitectureAsync">@(IsDiscoveringArchitecture ? "Discovering..." : "Discover existing architecture")</button>
            <button type="button" class="primary-action" disabled="@(!CanSelectPackages || IsSelectingPackages)" @onclick="SelectApprovedPackagesAsync">@(IsSelectingPackages ? "Selecting..." : "Select approved packages")</button>
            <button type="button" class="primary-action" disabled="@(!CanCreatePlanningCandidate || IsCreatingPlanningCandidate)" @onclick="CreatePlanningCandidateAsync">@(IsCreatingPlanningCandidate ? "Planning..." : "Create governed AI plan")</button>
            <button type="button" class="primary-action" disabled="@(!CanCreateCodeCandidate || IsCreatingCodeCandidate)" @onclick="CreateCodeCandidateAsync">@(IsCreatingCodeCandidate ? "Generating..." : "Create governed code candidate")</button>
            <button type="button" class="primary-action" disabled="@(!CanRunStaticValidation || IsRunningStaticValidation)" @onclick="RunStaticValidationAsync">@(IsRunningStaticValidation ? "Validating..." : "Run governed Static Validation")</button>
            <button type="button" class="primary-action" disabled="@(!CanRunSecurityValidation || IsRunningSecurityValidation)" @onclick="RunSecurityValidationAsync">@(IsRunningSecurityValidation ? "Validating security..." : "Run governed Security Validation")</button>
            <button type="button" class="primary-action" disabled="@(!CanRunSandbox || IsRunningSandbox)" @onclick="RunSandboxAsync">@(IsRunningSandbox ? "Requesting isolated execution..." : "Run governed Security Sandbox")</button>
            <button type="button" class="primary-action" disabled="@(!CanRunTests || IsRunningTests)" @onclick="RunTestsAsync">@(IsRunningTests ? "Running governed tests..." : "Run governed Tests")</button>
            <button type="button" class="primary-action" disabled="@(!CanRecordHumanReview || IsRecordingHumanReview)" @onclick="RecordHumanReviewAsync">@(IsRecordingHumanReview ? "Verifying human decision..." : "Record governed Human Review")</button>
            <button type="button" class="primary-action" disabled="@(!CanCreateGitCommit || IsCreatingGitCommit)" @onclick="CreateGitCommitAsync">@(IsCreatingGitCommit ? "Creating governed signed commit..." : "Create governed Git commit")</button>
            <button type="button" class="primary-action" disabled="@(!CanExecuteCiCd || IsExecutingCiCd)" @onclick="ExecuteCiCdAsync">@(IsExecutingCiCd ? "Executing governed pipeline..." : "Execute governed CI/CD")</button>
            <button type="button" class="primary-action" disabled="@(!CanPublishArtifact || IsPublishingArtifact)" @onclick="PublishArtifactAsync">@(IsPublishingArtifact ? "Publishing governed Artifact..." : "Publish governed Artifact")</button>
            <button type="button" class="primary-action" disabled="@(!CanDeploy || IsDeploying)" @onclick="DeployAsync">@(IsDeploying ? "Running sovereign preflight..." : "Deploy governed non-production service")</button>
            <button type="button" class="primary-action" disabled="@(!CanActivateTelemetry || IsActivatingTelemetry)" @onclick="ActivateTelemetryAsync">@(IsActivatingTelemetry ? "Verifying redaction and collectors..." : "Activate governed OpenTelemetry")</button>
            <button type="button" class="primary-action" disabled="@(!CanRunAutomaticRegistration || IsRunningAutomaticRegistration)" @onclick="RunAutomaticRegistrationAsync">@(IsRunningAutomaticRegistration ? "Registering atomically..." : "Execute governed Automatic Registration")</button>
            <button type="button" class="primary-action" disabled="@(!CanContextualizeEnterpriseModel || IsContextualizingEnterpriseModel)" @onclick="ContextualizeEnterpriseModelAsync">@(IsContextualizingEnterpriseModel ? "Revalidating Enterprise Object..." : "Contextualize governed Enterprise Model")</button>
            <button type="button" class="primary-action" disabled="@(!CanCompleteEvidence || IsCompletingEvidence)" @onclick="CompleteEvidenceAsync">@(IsCompletingEvidence ? "Verifying ten-stage chain..." : "Complete governed Evidence chain")</button>
        </div>
        <p class="evaluation" role="status">@EvaluationMessage</p>
        @if (LastReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed intent validation receipt">
                <div><dt>Submission</dt><dd>@LastReceipt.SubmissionId</dd></div>
                <div><dt>Status</dt><dd>@LastReceipt.Status</dd></div>
                <div><dt>Intent digest</dt><dd>@LastReceipt.IntentDigest</dd></div>
                <div><dt>Persisted</dt><dd>@(LastReceipt.IsPersisted ? "Yes" : "No — validation only")</dd></div>
            </dl>
        }
        @if (RegistrationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed intent registration receipt">
                <div><dt>Registration</dt><dd>@RegistrationReceipt.RegistrationId</dd></div>
                <div><dt>Policy</dt><dd>@RegistrationReceipt.PolicyOutcome</dd></div>
                <div><dt>Disposition</dt><dd>@RegistrationReceipt.Disposition</dd></div>
                <div><dt>Evidence</dt><dd>@RegistrationReceipt.RegistrationEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(RegistrationReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (ContextReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Enterprise Context receipt">
                <div><dt>Discovery</dt><dd>@ContextReceipt.DiscoveryId</dd></div>
                <div><dt>Policy</dt><dd>@ContextReceipt.PolicyOutcome</dd></div>
                <div><dt>Released items</dt><dd>@ContextReceipt.Items.Count</dd></div>
                <div><dt>Context digest</dt><dd>@ContextReceipt.ContextSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@ContextReceipt.DiscoveryEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(ContextReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (SystemsReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Existing Systems receipt">
                <div><dt>Discovery</dt><dd>@SystemsReceipt.DiscoveryId</dd></div>
                <div><dt>Released systems</dt><dd>@SystemsReceipt.Systems.Count</dd></div>
                <div><dt>Inventory digest</dt><dd>@SystemsReceipt.InventorySha256Digest</dd></div>
                <div><dt>Can advance</dt><dd>@(SystemsReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (ArchitectureReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Authorized Existing Architecture receipt">
                <div><dt>Discovery</dt><dd>@ArchitectureReceipt.DiscoveryId</dd></div>
                <div><dt>Released items</dt><dd>@ArchitectureReceipt.Items.Count</dd></div>
                <div><dt>Architecture digest</dt><dd>@ArchitectureReceipt.ArchitectureSha256Digest</dd></div>
                <div><dt>Can advance</dt><dd>@(ArchitectureReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (PackagesReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Approved Packages receipt">
                <div><dt>Selection</dt><dd>@PackagesReceipt.SelectionId</dd></div>
                <div><dt>Released packages</dt><dd>@PackagesReceipt.Packages.Count</dd></div>
                <div><dt>Selection digest</dt><dd>@PackagesReceipt.SelectionSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@PackagesReceipt.SelectionEvidenceReference</dd></div>
                <div><dt>Can advance</dt><dd>@(PackagesReceipt.CanAdvance ? "Yes" : "No — next gate remains separate")</dd></div>
            </dl>
        }
        @if (PlanningReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed AI Planning receipt">
                <div><dt>Planning</dt><dd>@PlanningReceipt.PlanningId</dd></div>
                <div><dt>Policy</dt><dd>@PlanningReceipt.PolicyOutcome</dd></div>
                <div><dt>Candidate digest</dt><dd>@PlanningReceipt.CandidateSha256Digest</dd></div>
                <div><dt>Evaluation findings</dt><dd>@PlanningReceipt.EvaluationFindings.Count</dd></div>
                <div><dt>Evidence</dt><dd>@PlanningReceipt.PlanningEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(PlanningReceipt.IsExecutable ? "Yes" : "No — planning only")</dd></div>
                <div><dt>Can advance</dt><dd>@(PlanningReceipt.CanAdvance ? "Yes" : "No — Code Generation remains separate")</dd></div>
            </dl>
        }
        @if (CodeGenerationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Code Generation receipt">
                <div><dt>Generation</dt><dd>@CodeGenerationReceipt.GenerationId</dd></div>
                <div><dt>Policy</dt><dd>@CodeGenerationReceipt.PolicyOutcome</dd></div>
                <div><dt>Candidate digest</dt><dd>@CodeGenerationReceipt.CandidateSha256Digest</dd></div>
                <div><dt>Authorized output paths</dt><dd>@CodeGenerationReceipt.GeneratedFilePaths.Count</dd></div>
                <div><dt>Evaluation findings</dt><dd>@CodeGenerationReceipt.EvaluationFindings.Count</dd></div>
                <div><dt>Evidence</dt><dd>@CodeGenerationReceipt.GenerationEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(CodeGenerationReceipt.IsExecutable ? "Yes" : "No — inert candidate data")</dd></div>
                <div><dt>Applied</dt><dd>@(CodeGenerationReceipt.IsApplied ? "Yes" : "No — no filesystem write")</dd></div>
                <div><dt>Can advance</dt><dd>@(CodeGenerationReceipt.CanAdvance ? "Yes" : "No — Static Validation remains separate")</dd></div>
            </dl>
        }
        @if (StaticValidationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Static Validation receipt">
                <div><dt>Validation</dt><dd>@StaticValidationReceipt.ValidationId</dd></div>
                <div><dt>Policy</dt><dd>@StaticValidationReceipt.PolicyOutcome</dd></div>
                <div><dt>Gate</dt><dd>@StaticValidationReceipt.Gate</dd></div>
                <div><dt>Accepted</dt><dd>@(StaticValidationReceipt.IsAccepted ? "Yes" : "No")</dd></div>
                <div><dt>Controls</dt><dd>@StaticValidationReceipt.ControlReports.Count</dd></div>
                <div><dt>Report digest</dt><dd>@StaticValidationReceipt.ReportSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@StaticValidationReceipt.ValidationEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(StaticValidationReceipt.IsExecutable ? "Yes" : "No — inspection only")</dd></div>
                <div><dt>Can advance</dt><dd>@(StaticValidationReceipt.CanAdvance ? "Yes" : "No — Security Validation remains separate")</dd></div>
            </dl>
        }
        @if (SecurityValidationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Security Validation receipt">
                <div><dt>Validation</dt><dd>@SecurityValidationReceipt.ValidationId</dd></div>
                <div><dt>Policy</dt><dd>@SecurityValidationReceipt.PolicyOutcome</dd></div>
                <div><dt>Gate</dt><dd>@SecurityValidationReceipt.Gate</dd></div>
                <div><dt>Accepted</dt><dd>@(SecurityValidationReceipt.IsAccepted ? "Yes" : "No")</dd></div>
                <div><dt>Controls</dt><dd>@SecurityValidationReceipt.ControlReports.Count</dd></div>
                <div><dt>Security report digest</dt><dd>@SecurityValidationReceipt.SecurityReportSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@SecurityValidationReceipt.ValidationEvidenceReference</dd></div>
                <div><dt>Executable</dt><dd>@(SecurityValidationReceipt.IsExecutable ? "Yes" : "No — inspection only")</dd></div>
                <div><dt>Can advance</dt><dd>@(SecurityValidationReceipt.CanAdvance ? "Yes" : "No — Sandbox remains separate")</dd></div>
            </dl>
        }
        @if (SandboxReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Security Sandbox receipt">
                <div><dt>Execution</dt><dd>@SandboxReceipt.ExecutionId</dd></div>
                <div><dt>Policy</dt><dd>@SandboxReceipt.PolicyOutcome</dd></div>
                <div><dt>Accepted</dt><dd>@(SandboxReceipt.IsAccepted ? "Yes" : "No")</dd></div>
                <div><dt>Isolation</dt><dd>Firecracker-class ephemeral microVM</dd></div>
                <div><dt>Exit</dt><dd>@SandboxReceipt.ExitCode</dd></div>
                <div><dt>Result digest</dt><dd>@SandboxReceipt.ResultSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@SandboxReceipt.ExecutionEvidenceReference</dd></div>
                <div><dt>Production effect</dt><dd>@(SandboxReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(SandboxReceipt.CanAdvance ? "Yes" : "No — Tests remains separate")</dd></div>
            </dl>
        }
        @if (TestsReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Tests receipt">
                <div><dt>Execution</dt><dd>@TestsReceipt.ExecutionId</dd></div>
                <div><dt>Policy</dt><dd>@TestsReceipt.PolicyOutcome</dd></div>
                <div><dt>Accepted</dt><dd>@(TestsReceipt.IsAccepted ? "Yes" : "No")</dd></div>
                <div><dt>Required tests</dt><dd>@TestsReceipt.TestResults.Count</dd></div>
                <div><dt>Result digest</dt><dd>@TestsReceipt.ResultSha256Digest</dd></div>
                <div><dt>Evidence</dt><dd>@TestsReceipt.TestsEvidenceReference</dd></div>
                <div><dt>Production effect</dt><dd>@(TestsReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(TestsReceipt.CanAdvance ? "Yes" : "No — Human Review remains separate")</dd></div>
            </dl>
        }
        @if (HumanReviewReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Human Review receipt">
                <div><dt>Review</dt><dd>@HumanReviewReceipt.ReviewId</dd></div>
                <div><dt>Policy</dt><dd>@HumanReviewReceipt.PolicyOutcome</dd></div>
                <div><dt>Recorded</dt><dd>@(HumanReviewReceipt.IsRecorded ? "Yes" : "No")</dd></div>
                <div><dt>Decision</dt><dd>@HumanReviewReceipt.Decision</dd></div>
                <div><dt>Reviewer</dt><dd>@HumanReviewReceipt.ReviewerSubjectId</dd></div>
                <div><dt>Evidence</dt><dd>@HumanReviewReceipt.ReviewEvidenceReference</dd></div>
                <div><dt>Production effect</dt><dd>@(HumanReviewReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(HumanReviewReceipt.CanAdvance ? "Yes" : "No — Git remains separate")</dd></div>
            </dl>
        }
        @if (GitReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Git receipt">
                <div><dt>Operation</dt><dd>@GitReceipt.OperationId</dd></div>
                <div><dt>Policy</dt><dd>@GitReceipt.PolicyOutcome</dd></div>
                <div><dt>Committed</dt><dd>@(GitReceipt.IsCommitted ? "Yes" : "No")</dd></div>
                <div><dt>Commit</dt><dd>@GitReceipt.CommitId</dd></div>
                <div><dt>Signed</dt><dd>@(GitReceipt.CommitSigned ? "Yes" : "No")</dd></div>
                <div><dt>Source mutation</dt><dd>@(GitReceipt.SourceMutationOccurred ? "Yes" : "No")</dd></div>
                <div><dt>CI/CD triggered</dt><dd>@(GitReceipt.CiCdTriggered ? "Yes" : "No")</dd></div>
                <div><dt>Production effect</dt><dd>@(GitReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(GitReceipt.CanAdvance ? "Yes" : "No — CI/CD remains separate")</dd></div>
            </dl>
        }
        @if (CiCdReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed CI/CD receipt">
                <div><dt>Execution</dt><dd>@CiCdReceipt.ExecutionId</dd></div>
                <div><dt>Policy</dt><dd>@CiCdReceipt.PolicyOutcome</dd></div>
                <div><dt>Accepted</dt><dd>@(CiCdReceipt.IsAccepted ? "Yes" : "No")</dd></div>
                <div><dt>Stages</dt><dd>@CiCdReceipt.Stages.Count</dd></div>
                <div><dt>Output manifest</dt><dd>@CiCdReceipt.PipelineOutputManifestSha256Digest</dd></div>
                <div><dt>Source mutation</dt><dd>@(CiCdReceipt.SourceMutationOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Artifact published</dt><dd>@(CiCdReceipt.ArtifactPublished ? "Yes" : "No")</dd></div>
                <div><dt>Deployment</dt><dd>@(CiCdReceipt.DeploymentOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Production effect</dt><dd>@(CiCdReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(CiCdReceipt.CanAdvance ? "Yes" : "No — Artifact remains separate")</dd></div>
            </dl>
        }
        @if (ArtifactReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Artifact receipt">
                <div><dt>Publication</dt><dd>@ArtifactReceipt.PublicationId</dd></div>
                <div><dt>Policy</dt><dd>@ArtifactReceipt.PolicyOutcome</dd></div>
                <div><dt>Published</dt><dd>@(ArtifactReceipt.ArtifactPublished ? "Yes" : "No")</dd></div>
                <div><dt>Coordinate</dt><dd>@($"{ArtifactReceipt.Coordinate.Kind}:{ArtifactReceipt.Coordinate.Name}:{ArtifactReceipt.Coordinate.Version}")</dd></div>
                <div><dt>Supply chain</dt><dd>@(ArtifactReceipt.SupplyChainVerified ? "Verified" : "Rejected")</dd></div>
                <div><dt>Registry mutation</dt><dd>@(ArtifactReceipt.RegistryMutated ? "Yes" : "No")</dd></div>
                <div><dt>Deployment</dt><dd>@(ArtifactReceipt.DeploymentOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Production effect</dt><dd>@(ArtifactReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(ArtifactReceipt.CanAdvance ? "Yes" : "No — Deployment remains separate")</dd></div>
            </dl>
        }
        @if (DeploymentReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Sovereign Deployment receipt">
                <div><dt>Deployment</dt><dd>@DeploymentReceipt.DeploymentId</dd></div>
                <div><dt>Policy</dt><dd>@DeploymentReceipt.PolicyOutcome</dd></div>
                <div><dt>Target</dt><dd>@DeploymentReceipt.TargetEnvironment</dd></div>
                <div><dt>Runtime</dt><dd>@DeploymentReceipt.RuntimeIdentity</dd></div>
                <div><dt>External effect</dt><dd>@(DeploymentReceipt.ExternalEffectOccurred ? "Yes — bounded synthetic runtime" : "No")</dd></div>
                <div><dt>Production effect</dt><dd>@(DeploymentReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Telemetry</dt><dd>@(DeploymentReceipt.TelemetryConfigured ? "Configured" : "Not configured")</dd></div>
                <div><dt>Can advance</dt><dd>@(DeploymentReceipt.CanAdvance ? "Yes" : "No — OpenTelemetry remains separate")</dd></div>
            </dl>
        }
        @if (OpenTelemetryReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed OpenTelemetry receipt">
                <div><dt>Activation</dt><dd>@OpenTelemetryReceipt.ActivationId</dd></div>
                <div><dt>Policy</dt><dd>@OpenTelemetryReceipt.PolicyOutcome</dd></div>
                <div><dt>Service</dt><dd>@($"{OpenTelemetryReceipt.ServiceName}:{OpenTelemetryReceipt.ServiceVersion}")</dd></div>
                <div><dt>Signals</dt><dd>@string.Join(", ", OpenTelemetryReceipt.Signals.Select(signal => signal.Signal))</dd></div>
                <div><dt>Telemetry</dt><dd>@(OpenTelemetryReceipt.TelemetryConfigured ? "Configured" : "Not configured")</dd></div>
                <div><dt>Production effect</dt><dd>@(OpenTelemetryReceipt.ProductionEffectOccurred ? "Yes" : "No")</dd></div>
                <div><dt>Can advance</dt><dd>@(OpenTelemetryReceipt.CanAdvance ? "Yes" : "No — Automatic Registration remains separate")</dd></div>
            </dl>
        }
        @if (AutomaticRegistrationReceipt is not null)
        {
            <dl class="validation-receipt" aria-label="Governed Automatic Registration receipt">
                <div><dt>Registration</dt><dd>@AutomaticRegistrationReceipt.RegistrationId</dd></div>
                <div><dt>Policy</dt><dd>@AutomaticRegistrationReceipt.PolicyOutcome</dd></div>
