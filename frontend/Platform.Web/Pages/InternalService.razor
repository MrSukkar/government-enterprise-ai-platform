        ArchitectureReceipt is { IsArchitectureReleased: true, CanAdvance: false, ArchitectureSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.packages.select");

    private bool CanCreatePlanningCandidate =>
        PackagesReceipt is { IsSelectionReleased: true, CanAdvance: false, SelectionSha256Digest: not null, SelectionEvidenceReference: not null } &&
        ContextReceipt?.DiscoveryEvidenceReference is not null &&
        SystemsReceipt?.DiscoveryEvidenceReference is not null &&
        ArchitectureReceipt?.DiscoveryEvidenceReference is not null &&
        ExperienceContext.HasPermission("developer.internal-service.ai-planning.create");

    private bool CanCreateCodeCandidate =>
        RegistrationReceipt is { IsPersisted: true } &&
        ContextReceipt is { IsContextReleased: true } &&
        SystemsReceipt is { IsInventoryReleased: true } &&
        ArchitectureReceipt is { IsArchitectureReleased: true } &&
        PlanningReceipt is { IsPlanningCandidateReleased: true, IsExecutable: false, CanAdvance: false,
            CandidateSha256Digest: not null, PlanningEvidenceReference: not null } &&
        PackagesReceipt is { IsSelectionReleased: true, SelectionSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.code-generation.create");

    private bool CanRunStaticValidation =>
        CodeGenerationReceipt is { IsCodeCandidateReleased: true, IsExecutable: false, IsApplied: false,
            CanAdvance: false, CandidateSha256Digest: not null, GenerationEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.static-validation.create");

    private bool CanRunSecurityValidation =>
        StaticValidationReceipt is { IsAccepted: true, IsExecutable: false, CanAdvance: false,
            ReportSha256Digest: not null, ValidationEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.security-validation.create");

    private bool CanRunSandbox =>
        SecurityValidationReceipt is { IsAccepted: true, IsExecutable: false, CanAdvance: false,
            SecurityReportSha256Digest: not null, ValidationEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.sandbox.execute");

    private bool CanRunTests =>
        SandboxReceipt is { IsAccepted: true, ProductionEffectOccurred: false, CanAdvance: false,
            ResultSha256Digest: not null, ExecutionEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.tests.execute");

    private bool CanRecordHumanReview =>
        TestsReceipt is { IsAccepted: true, ProductionEffectOccurred: false, CanAdvance: false,
            ResultSha256Digest: not null, TestsEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.human-review.decide") &&
        !string.IsNullOrWhiteSpace(ReviewRationale) &&
        !string.IsNullOrWhiteSpace(HumanAttestationReference);

    private bool CanCreateGitCommit =>
        HumanReviewReceipt is { IsRecorded: true, IsApproved: true, ProductionEffectOccurred: false, CanAdvance: false,
            ReviewPackageSha256Digest: not null, ReviewEvidenceReference: not null } &&
        TestsReceipt is { IsAccepted: true, ResultSha256Digest: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.git.commit") &&
        GitExpectedChangeSetSha256Digest.Length == 64 &&
        GitExpectedChangeSetSha256Digest.All(Uri.IsHexDigit);

    private bool CanExecuteCiCd =>
        GitReceipt is { IsCommitted: true, CommitSigned: true, CiCdTriggered: false,
            ProductionEffectOccurred: false, CanAdvance: false, CommitId: not null,
            TreeSha256Digest: not null, GitEvidenceReference: not null } &&
        ExperienceContext.HasPermission("developer.internal-service.cicd.execute") &&
        CiCdExpectedWorkflowSha256Digest.Length == 64 &&
        CiCdExpectedWorkflowSha256Digest.All(Uri.IsHexDigit);

    private bool CanPublishArtifact =>
