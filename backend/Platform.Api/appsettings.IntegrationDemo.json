{
  "IdentityProvider": {
    "Authority": "https://localhost:8443/realms/geaip-demo",
    "Audience": "platform-api",
    "RequireHttpsMetadata": true
  },
  "IntegrationDemo": {
    "FrontendOrigin": "https://localhost:7071"
  },
  "PolicyControlPlane": {
    "OpaEndpoint": "https://localhost:8181/v1/data/geaip/decision",
    "BundleVerificationEndpoint": "https://localhost:8181/v1/data/geaip/bundle/verification",
    "TrustAnchorReference": "trust://demo/opa/demo-opa-signing-01",
    "Environment": "IntegrationDemo",
    "RequestTimeoutSeconds": 10,
    "MaximumResponseBytes": 65536
  },
  "Neo4jEnterpriseGraph": {
    "Uri": "neo4j+s://localhost:7687",
    "Database": "neo4j",
    "QueryTimeoutSeconds": 10,
    "MaximumRecords": 10
  }
}
