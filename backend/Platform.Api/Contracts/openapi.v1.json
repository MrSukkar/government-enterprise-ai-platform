{
  "openapi": "3.1.0",
  "info": {
    "title": "Government Enterprise AI Platform API",
    "version": "1.0.0",
    "summary": "Governed API boundary for the sovereign enterprise AI platform.",
    "description": "The contract exposes only capabilities accepted in the approved phase roadmap. Navigation or contract visibility never grants authorization."
  },
  "servers": [
    { "url": "/", "description": "Current sovereign deployment" }
  ],
  "tags": [
    { "name": "Platform", "description": "Platform-level technical endpoints." },
    { "name": "Create Internal Service", "description": "Governed internal-service product boundary." }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getPlatformHealth",
        "summary": "Read the technical liveness status.",
        "tags": ["Platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "The API process is healthy.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getPlatformReadiness",
        "summary": "Read fail-closed runtime readiness.",
        "description": "Returns 503 until every required runtime boundary is connected. Contract visibility does not make an unavailable capability executable.",
        "tags": ["Platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "All required runtime boundaries are connected.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "503": {
            "description": "One or more runtime boundaries are not connected; the platform remains fail-closed.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/foundation": {
      "get": {
        "operationId": "getInternalServiceFoundation",
        "summary": "Read the approved Create Internal Service product foundation.",
        "description": "Returns public product metadata and the governed delivery sequence. It grants no execution authority.",
        "tags": ["Create Internal Service"],
        "security": [],
        "responses": {
          "200": {
            "description": "The approved Create Internal Service product foundation.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents": {
      "post": {
        "operationId": "submitInternalServiceIntent",
        "summary": "Validate a governed internal-service intent submission.",
        "description": "Requires authenticated identity, tenant, purpose, classification, permission, and authorization evidence. A successful validation is not persisted, is not an OPA decision, and cannot execute material work.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GovernedIntentSubmission" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The intent passed server validation but was not persisted and cannot execute.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GovernedIntentValidationReceipt" }
              }
            }
          },
          "400": {
            "description": "The submission shape or classification is invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "401": {
            "description": "A governed authenticated identity is required.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "403": {
            "description": "Tenant, permission, clearance, purpose, or authorization evidence validation failed.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents/register": {
      "post": {
        "operationId": "registerInternalServiceIntent",
        "summary": "Register a validated internal-service intent after OPA approval.",
        "description": "Requires authenticated authorization plus configured OPA and atomic evidence-bearing persistence adapters. Missing adapters, policy denial, or concurrency failure cannot create institutional state.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GovernedIntentRegistrationInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An idempotent retry matched the existing governed registration.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GovernedIntentRegistrationReceipt" } } }
          },
          "201": {
            "description": "OPA permitted the request and intent plus registration evidence were created atomically.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GovernedIntentRegistrationReceipt" } } }
          },
          "400": {
            "description": "The registration request, policy reference, or persisted response is invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "401": {
            "description": "A governed authenticated identity is required.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "403": {
            "description": "Authorization or OPA denied the registration.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "409": {
            "description": "The expected registration version did not match.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "503": {
            "description": "The OPA policy gate or atomic registration repository is unavailable; no mutation occurred.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents/{registrationId}/enterprise-context": {
      "post": {
        "operationId": "discoverInternalServiceEnterpriseContext",
        "summary": "Discover authorized Enterprise Context for a registered governed intent.",
        "description": "OPA establishes an explicit resource and modality scope before source access. Authorized retrieval re-checks every candidate before an evidence-bearing context snapshot is released. The result cannot advance to Existing Systems or invoke AI.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnterpriseContextDiscoveryInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized candidates were re-checked and released in a deterministic evidence-bearing snapshot that cannot advance.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedEnterpriseContextDiscoveryReceipt" } } }
          },
          "400": {
            "description": "The request, registered intent, policy decision, retrieval result, or evidence receipt is structurally invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "401": {
            "description": "A governed authenticated identity is required.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "403": {
            "description": "Authorization or OPA denied Enterprise Context discovery.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedEnterpriseContextDiscoveryReceipt" } },
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "404": {
            "description": "The tenant-scoped governed intent registration was not found.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "503": {
            "description": "A registered-intent reader, OPA gate, retrieval source, or evidence recorder is unavailable; no source access or mutation occurred.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents/{registrationId}/enterprise-context/{contextDiscoveryId}/existing-systems": {
      "post": {
        "operationId": "discoverInternalServiceExistingSystems",
        "summary": "Discover authorized existing systems for an evidence-bearing Enterprise Context snapshot.",
        "description": "OPA establishes explicit system-object, relationship-type, and source-kind scope before inventory access. Every system and relationship is structurally validated, re-authorized, and evidenced. No live connector, Enterprise Model mutation, or Existing Architecture advancement is available.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "contextDiscoveryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExistingSystemsDiscoveryInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized systems and relationships were released in a deterministic evidence-bearing snapshot that cannot advance.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedExistingSystemsDiscoveryReceipt" } } }
          },
          "400": {
            "description": "The request, context, policy decision, inventory result, authorization result, or evidence receipt is structurally invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "401": {
            "description": "A governed authenticated identity is required.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "403": {
            "description": "Authorization or OPA denied Existing Systems discovery.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedExistingSystemsDiscoveryReceipt" } },
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "404": {
            "description": "The tenant-scoped authorized Enterprise Context snapshot was not found.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "503": {
            "description": "A context reader, OPA gate, inventory source, result authorizer, or evidence recorder is unavailable; no inventory source access or mutation occurred.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents/{registrationId}/enterprise-context/{contextDiscoveryId}/existing-systems/{systemsDiscoveryId}/existing-architecture": {
      "post": {
        "operationId": "discoverInternalServiceExistingArchitecture",
        "summary": "Discover authorized existing architecture for an evidence-bearing Existing Systems snapshot.",
        "description": "OPA establishes explicit system, source, item-kind, relationship, and classification scope before architecture access. Every approved item is constitutionally checked, re-authorized, and evidenced. No architecture redesign, institutional mutation, or Approved Packages advancement is available.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "contextDiscoveryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "systemsDiscoveryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExistingArchitectureDiscoveryInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized approved architecture items were released in a deterministic evidence-bearing snapshot that cannot advance.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedExistingArchitectureDiscoveryReceipt" } } }
          },
          "400": {
            "description": "The request, prerequisite snapshot, policy decision, architecture result, conformance result, authorization result, or evidence receipt is structurally invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "401": {
            "description": "A governed authenticated identity is required.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "403": {
            "description": "Authorization, OPA, result authorization, or constitutional conformance denied Existing Architecture discovery.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizedExistingArchitectureDiscoveryReceipt" } },
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          },
          "404": {
            "description": "The tenant-scoped authorized Existing Systems snapshot was not found.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          },
          "503": {
            "description": "An Existing Systems reader, OPA gate, approved architecture source, conformance validator, result authorizer, or evidence recorder is unavailable; no architecture source access or mutation occurred.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
          }
        }
      }
    },
    "/api/v1/internal-services/intents/{registrationId}/enterprise-context/{contextDiscoveryId}/existing-systems/{systemsDiscoveryId}/existing-architecture/{architectureDiscoveryId}/approved-packages": {
      "post": {
        "operationId": "selectInternalServiceApprovedPackages",
        "summary": "Select exact institutionally approved packages for an authorized architecture snapshot.",
        "description": "OPA authorizes exact immutable coordinates before registry reads. Eligibility, provenance, SBOM, signature, sovereign-registry assurance, and per-result authorization are required. No package transfer, execution, registry mutation, or AI Planning advancement is available.",
        "tags": ["Create Internal Service"],
        "security": [ { "oidcBearer": [] } ],
        "parameters": [
          { "name": "registrationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "contextDiscoveryId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "systemsDiscoveryId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "architectureDiscoveryId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovedPackagesSelectionInput" } } }
        },
        "responses": {
          "200": { "description": "Exact packages passed all governed controls and were released in a non-advancing evidence-bearing snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GovernedApprovedPackagesSelectionReceipt" } } } },
          "400": { "description": "The request or a governed package boundary result is invalid.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "401": { "description": "A governed authenticated identity is required.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "403": { "description": "Authorization, OPA, eligibility, assurance, or result authorization denied selection.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GovernedApprovedPackagesSelectionReceipt" } }, "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "404": { "description": "The authorized Existing Architecture snapshot was not found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "503": { "description": "A required architecture, policy, registry, assurance, authorization, or evidence adapter is unavailable; no registry access, package transfer, or mutation occurred.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/openapi/v1.json": {
      "get": {
        "operationId": "getOpenApiContract",
        "summary": "Read this approved API contract.",
        "tags": ["Platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 contract.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC/OAuth2 access token validated against the deployment-approved sovereign identity authority."
      }
    },
    "schemas": {
      "GovernedIntentSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submissionId", "tenantId", "purpose", "classification", "serviceName",
          "mission", "primaryUsers", "authorizationEvidenceReference", "intentEvidenceReferences"
        ],
        "properties": {
          "submissionId": { "type": "string", "format": "uuid" },
          "tenantId": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": ["Public", "Internal", "Confidential", "Secret", "TopSecret"]
          },
          "serviceName": { "type": "string", "minLength": 1 },
          "mission": { "type": "string", "minLength": 1 },
          "primaryUsers": { "type": "string", "minLength": 1 },
          "authorizationEvidenceReference": { "type": "string", "minLength": 1 },
          "intentEvidenceReferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "GovernedIntentValidationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submissionId", "tenantId", "subjectId", "classification", "intentDigest",
          "validatedAt", "status", "isPersisted", "isPolicyEvaluated", "canExecute",
          "nextRequiredGate", "evidenceReferences"
        ],
        "properties": {
          "submissionId": { "type": "string", "format": "uuid" },
          "tenantId": { "type": "string" },
          "subjectId": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["Public", "Internal", "Confidential", "Secret", "TopSecret"]
          },
          "intentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "validatedAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "const": "validated-not-persisted" },
          "isPersisted": { "type": "boolean", "const": false },
          "isPolicyEvaluated": { "type": "boolean", "const": false },
          "canExecute": { "type": "boolean", "const": false },
          "nextRequiredGate": { "type": "string" },
          "evidenceReferences": { "type": "array", "items": { "type": "string" } }
        }
      },
      "IntentPolicyBundleReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundleId", "version", "sha256Digest", "signatureReference", "environment", "activatedAt"],
        "properties": {
          "bundleId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256Digest": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
          "signatureReference": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "activatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "GovernedIntentRegistrationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registrationId", "submission", "environment", "policyBundle", "expectedVersion"],
        "properties": {
          "registrationId": { "type": "string", "format": "uuid" },
          "submission": { "$ref": "#/components/schemas/GovernedIntentSubmission" },
          "environment": { "type": "string", "minLength": 1 },
          "policyBundle": { "$ref": "#/components/schemas/IntentPolicyBundleReference" },
          "expectedVersion": { "type": "integer", "format": "int64", "minimum": -1 }
        }
      },
      "GovernedIntentRegistrationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registrationId", "submissionId", "tenantId", "intentSha256Digest", "policyOutcome",
          "isPersisted", "canAdvance", "evidenceReferences", "nextRequiredGate", "completedAt"
        ],
        "properties": {
          "registrationId": { "type": "string", "format": "uuid" },
          "submissionId": { "type": "string", "format": "uuid" },
          "tenantId": { "type": "string" },
          "intentSha256Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "policyOutcome": { "type": "string", "enum": ["Deny", "Permit"] },
          "isPersisted": { "type": "boolean" },
          "canAdvance": { "type": "boolean", "const": false },
          "disposition": { "type": ["string", "null"], "enum": ["Created", "Unchanged", null] },
          "version": { "type": ["integer", "null"], "format": "int64" },
          "registrationEvidenceReference": { "type": ["string", "null"] },
          "evidenceReferences": { "type": "array", "items": { "type": "string" } },
          "nextRequiredGate": { "type": "string" },
          "completedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EnterpriseContextDiscoveryInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discoveryId", "expectedRegistrationVersion", "expectedIntentSha256Digest",
          "purpose", "registrationClassification", "environment", "policyBundle"
        ],
        "properties": {
          "discoveryId": { "type": "string", "format": "uuid" },
          "expectedRegistrationVersion": { "type": "integer", "format": "int64", "minimum": 0 },
          "expectedIntentSha256Digest": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "registrationClassification": {
            "type": "string",
            "enum": ["Public", "Internal", "Confidential", "Secret", "TopSecret"]
          },
          "environment": { "type": "string", "minLength": 1 },
          "policyBundle": { "$ref": "#/components/schemas/IntentPolicyBundleReference" }
        }
      },
      "AuthorizedEnterpriseContextItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceId", "classification", "content", "modality", "relevance", "source", "evidenceReferences"
        ],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": ["Public", "Internal", "Confidential", "Secret", "TopSecret"]
          },
          "content": { "type": "string", "minLength": 1 },
          "modality": { "type": "string", "enum": ["Graph", "Vector", "Lexical"] },
          "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "minLength": 1 },
          "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "AuthorizedEnterpriseContextDiscoveryReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discoveryId", "registrationId", "registrationVersion", "tenantId", "intentSha256Digest",
          "policyOutcome", "isContextReleased", "canAdvance", "items", "evidenceReferences",
          "nextRequiredGate", "completedAt"
        ],
        "properties": {
          "discoveryId": { "type": "string", "format": "uuid" },
          "registrationId": { "type": "string", "format": "uuid" },
          "registrationVersion": { "type": "integer", "format": "int64", "minimum": 0 },
          "tenantId": { "type": "string", "minLength": 1 },
          "intentSha256Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "policyOutcome": { "type": "string", "enum": ["Deny", "Permit"] },
          "isContextReleased": { "type": "boolean" },
          "canAdvance": { "type": "boolean", "const": false },
          "contextSha256Digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuthorizedEnterpriseContextItem" }
          },
          "discoveryEvidenceReference": { "type": ["string", "null"] },
          "evidenceReferences": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "nextRequiredGate": { "type": "string" },
          "completedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ExistingSystemsDiscoveryInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discoveryId", "expectedRegistrationVersion", "expectedIntentSha256Digest",
          "expectedContextSha256Digest", "purpose", "maximumClassification",
          "environment", "policyBundle"
        ],
        "properties": {
          "discoveryId": { "type": "string", "format": "uuid" },
          "expectedRegistrationVersion": { "type": "integer", "format": "int64", "minimum": 0 },
