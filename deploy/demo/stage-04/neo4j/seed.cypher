CREATE CONSTRAINT enterprise_object_identity IF NOT EXISTS FOR (resource:EnterpriseObject) REQUIRE (resource.tenantId, resource.resourceId) IS UNIQUE;
MERGE (p:EnterpriseObject {tenantId:'demo-permit-authority',resourceId:'enterprise-object:permit-renewal-policy'}) SET p.classification='Internal',p.classificationRank=1,p.contextContent='Synthetic demo policy: permit renewal requires verified identity and evidenced eligibility.',p.contextRelevance=0.99,p.source='enterprise-model',p.evidenceReferences=['evidence://demo/enterprise-context/policy/001'];
MERGE (c:EnterpriseObject {tenantId:'demo-permit-authority',resourceId:'enterprise-object:permit-renewal-service'}) SET c.classification='Internal',c.classificationRank=1,c.contextContent='Synthetic demo service context for National Permit Renewal.',c.contextRelevance=0.97,c.source='enterprise-model',c.evidenceReferences=['evidence://demo/enterprise-context/service/001'];
MERGE (a:EnterpriseObject {tenantId:'demo-permit-authority',resourceId:'11111111-1111-1111-1111-111111111111'}) SET a.type='PermitCaseService',a.state='Active',a.ownerId='demo-permit-authority',a.classification='Internal',a.classificationRank=1,a.policyReferences=['policy://demo/permit/renewal'],a.permittedActions=['renewal.read'],a.source='enterprise-model',a.sourceKind='enterprise-graph',a.confidence=0.98,a.evidenceReferences=['evidence://demo/existing-systems/case-service/001'],a.lifecycle='Active',a.createdAt=datetime('2026-09-18T00:00:00Z'),a.updatedAt=datetime('2026-09-18T00:00:00Z'),a.credentialsIncluded=false,a.liveSessionIncluded=false,a.executableCommandIncluded=false,a.externalEffectOccurred=false;
MERGE (b:EnterpriseObject {tenantId:'demo-permit-authority',resourceId:'22222222-2222-2222-2222-222222222222'}) SET b.type='EligibilityRegistry',b.state='Active',b.ownerId='demo-permit-authority',b.classification='Internal',b.classificationRank=1,b.policyReferences=['policy://demo/eligibility/read'],b.permittedActions=['eligibility.read'],b.source='enterprise-model',b.sourceKind='enterprise-graph',b.confidence=0.96,b.evidenceReferences=['evidence://demo/existing-systems/eligibility/001'],b.lifecycle='Active',b.createdAt=datetime('2026-09-18T00:00:00Z'),b.updatedAt=datetime('2026-09-18T00:00:00Z'),b.credentialsIncluded=false,b.liveSessionIncluded=false,b.executableCommandIncluded=false,b.externalEffectOccurred=false;
MERGE (a)-[r:DependsOn]->(b) SET r.knowledgeState='Confirmed',r.confidence=0.95,r.source='enterprise-model',r.evidenceReferences=['evidence://demo/existing-systems/relationship/001'],r.observedAt=datetime('2026-09-18T00:00:00Z');
