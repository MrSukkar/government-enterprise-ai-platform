{
  "realm": "geaip-demo",
  "enabled": true,
  "displayName": "Government Enterprise AI Platform Demo",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "platform-web",
      "name": "Government Enterprise AI Platform Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "https://localhost:7071",
      "baseUrl": "https://localhost:7071/",
      "redirectUris": [
        "https://localhost:7071/authentication/login-callback",
        "https://localhost:7071/authentication/logout-callback"
      ],
      "webOrigins": ["https://localhost:7071"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7071/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "demo-permit-authority",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "demo-persona",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "persona",
            "claim.value": "Demo Governed Operator",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "demo-purpose",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "purpose",
            "claim.value": "internal-service-delivery-demonstration",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "demo-clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "clearance",
            "claim.value": "Internal",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "demo-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "Developer HumanReviewer",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "demo-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "permission",
        "claim.value": "developer.internal-service.create developer.internal-service.intent.register developer.internal-service.context.discover developer.internal-service.systems.discover developer.internal-service.architecture.discover developer.internal-service.packages.select developer.internal-service.ai-planning.create developer.internal-service.code-generation.create developer.internal-service.static-validation.create developer.internal-service.security-validation.create developer.internal-service.sandbox.execute developer.internal-service.tests.execute developer.internal-service.human-review.decide developer.internal-service.git.commit developer.internal-service.cicd.execute developer.internal-service.artifact.publish operator.internal-service.deployment.execute operator.internal-service.telemetry.activate operator.internal-service.registration.execute operator.internal-service.enterprise-model.contextualize operator.internal-service.evidence.complete evidence.append evidence.verify",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "authorization-evidence",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "authorization_evidence",
            "claim.value": "evidence://demo/permit-renewal/authorization/001",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "10000000-0000-0000-0000-000000000012",
      "username": "demo.developer",
      "enabled": true,
      "email": "demo.developer@example.invalid",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Developer",
      "requiredActions": []
    },
    {
      "id": "10000000-0000-0000-0000-000000000013",
      "username": "demo.human-reviewer",
      "enabled": true,
      "email": "demo.human-reviewer@example.invalid",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Human Reviewer",
      "requiredActions": []
    }
  ]
}
